{
  "manifest_version": 3,
  "name": "Cambly Transcript Scraper",
  "version": "1.0.0",
  "description": "Scrape lesson transcripts from Cambly replay pages",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.cambly.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.cambly.com/*/student/replay/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
